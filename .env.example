# Example environment variables for local development.
# Copy to .env and adjust as needed.

APP_NAME=Generic Data Ingestion Service
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/ingestion.db

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
HTTP_USER_AGENT=GenericDataIngestionService/1.0
